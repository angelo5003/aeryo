#!/usr/bin/env bash
#
# Lightweight local stand-in for branch protection on `main` (GitHub
# branch protection is free for this public repo, but not enabled while
# there is a single pusher). Runs the fast subset of
# the Tier 1 CI checks — lint, typecheck, Jest — before allowing a push
# whose target branch is `main`. The slow jobs (Storybook, Playwright
# E2E, native builds) still only run in GitHub Actions.
#
# Pushes to any other branch are not gated.
# Bypass in an emergency with:  git push --no-verify
#
# Enabled via `git config core.hooksPath .githooks` (also: npm run hooks:install).

set -euo pipefail

protected_branch="main"
remote_ref_prefix="refs/heads/"

should_check=false
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "${remote_ref_prefix}${protected_branch}" ]; then
    should_check=true
  fi
done

if [ "$should_check" = false ]; then
  exit 0
fi

echo "pre-push: pushing to '$protected_branch' — running fast CI checks (lint, typecheck, test)…"
echo "         (bypass with 'git push --no-verify')"

npm run lint
npm run typecheck
npm test

echo "pre-push: checks passed."
