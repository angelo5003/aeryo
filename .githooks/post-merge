#!/usr/bin/env bash
#
# Keeps the code-review-graph MCP index in sync after `git pull`/`git
# merge` — the graph otherwise only updates via a Claude Code hook that
# fires on Claude's own Edit/Write tool calls, so a plain pull (by a
# human, CI, or a PR auto-merge someone then pulls down) would silently
# leave it stale. Best-effort: never blocks the merge.
#
# Enabled via `git config core.hooksPath .githooks` (also: npm run hooks:install).

set -uo pipefail

command -v code-review-graph >/dev/null 2>&1 || exit 0

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

code-review-graph update --skip-flows --repo "$repo_root" || true
