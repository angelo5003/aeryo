#!/usr/bin/env bash
#
# Keeps the code-review-graph MCP index in sync after switching branches
# — the graph otherwise only updates via a Claude Code hook that fires
# on Claude's own Edit/Write tool calls, so a plain `git checkout`/
# `git switch` would silently leave it built against the wrong branch.
# Best-effort: never blocks the checkout.
#
# Git passes: $1 previous HEAD, $2 new HEAD, $3 "1" if this was a branch
# checkout, "0" if just files. We only care about the branch-switch case.
#
# Enabled via `git config core.hooksPath .githooks` (also: npm run hooks:install).

set -uo pipefail

branch_checkout="${3:-0}"
[ "$branch_checkout" = "1" ] || exit 0

command -v code-review-graph >/dev/null 2>&1 || exit 0

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

code-review-graph update --skip-flows --repo "$repo_root" || true
