# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# superpowers scratch workspace (subagent-driven-development ledgers, briefs, reports)
.superpowers/

# typescript
*.tsbuildinfo
.tsbuildinfo*
next-env.d.ts

*storybook.log
storybook-static

# capacitor / xcode
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/App/App/public/

# capacitor / android
.gradle/
local.properties
android/app/build/
android/build/
android/.idea/
android/captures/
*.jks
*.keystore

# claude code session markers
.claude/.headroom_wrap_marker.json

# local Dutch learning guides generated by /leer — personal study material,
# not project source
docs/leren/

# python bytecode (e.g. .agents/skills/*/scripts)
__pycache__/
*.py[cod]
